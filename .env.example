BIGQUERY_DATASET=school_lunch
BIGQUERY_ORDERS_TABLE=orders_v2
GCS_BUCKET=chennaifood
GOOGLE_MAPS_API_KEY=server-restricted-google-maps-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=browser-restricted-google-maps-key
GOOGLE_PLACES_API_KEY=server-restricted-google-places-key
GOOGLE_MAPS_BROWSER_API_KEY=browser-restricted-maps-javascript-key
BIGQUERY_MARKETING_LOCATIONS_TABLE=marketing_locations
BIGQUERY_MARKETING_SEARCHES_TABLE=marketing_discovery_runs
