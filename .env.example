SENDGRID_API_KEY=store-in-secret-manager
SENDGRID_FROM_EMAIL=verified-sender@example.com
SENDGRID_FROM_NAME=LunchBox
WHATSAPP_ACCESS_TOKEN=store-in-secret-manager
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
CAMPAIGN_ADMIN_TOKEN=store-a-long-random-value-in-secret-manager
# Store either one JSON file (an array or { "franchises": [...] }) or one JSON file per franchise.
GCS_FRANCHISES_OBJECT=franchises.json
# Used only when GCS_FRANCHISES_OBJECT is unset.
GCS_FRANCHISES_PREFIX=franchises/
# Local JSON is the default source. Set this to `gcs` only after uploading the configured object.
# Franchise and franchise_students are stored in Firestore.
# Grant Firebase custom claims: { admin: true } or { roles: ["franchise"], franchise_ids: ["franchise-id"] }.
# Used by `node scripts/collect-chennai-franchises.mjs`; never expose this as NEXT_PUBLIC_.
SERPAPI_KEY=your-serpapi-key
ANALYTICS_HASH_SALT=store-a-random-secret-in-secret-manager
FIRESTORE_DATABASE_ID=(default)
DEFAULT_DAILY_CAPACITY=1500
FRANCHISE_NETWORK_TARGET=198
FRANCHISE_DAILY_STUDENT_CAPACITY=1500
ORDER_CUTOFF_IST=09:00
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-web-app-id
MARKETING_ADMIN_EMAIL=stephenraj040899@gmail.com
MARKETING_OS_PUBLIC=false
REQUIRE_FIREBASE_AUTH=true
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=store-in-secret-manager
RAZORPAY_WEBHOOK_SECRET=use-a-separate-strong-secret
ENABLE_PAYMENTS=true
FRANCHISE_PAYMENT_ENABLED=false
FRANCHISE_PAYMENT_AMOUNT_INR=
PAYMENT_HOLD_MINUTES=15
PAYMENT_EXPIRY_TASK_SECRET=store-a-random-task-secret-in-secret-manager
