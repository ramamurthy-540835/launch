# Store the API key in Secret Manager in deployed environments.
DATA_GOV_IN_API_KEY=your-data-gov-in-api-key

# Current official Variety-wise Daily Market Prices Data of Commodity resource.
INVENTORY_APMC_RESOURCE_ID=35985678-0d79-46b4-9ed6-6f13308a1d24
INVENTORY_APMC_MAX_AGE_DAYS=7

# Exactly two ordered markets: Sangli is primary and Salem is fallback.
INVENTORY_APMC_MARKETS_JSON=[{"state":"Maharashtra","district":"Sangli"},{"state":"Tamil Nadu","district":"Salem"}]

# Map each internal inventory item to its exact AGMARKNET commodity/variety/grade.
# supplierId is optional during sync but must be assigned before rate approval.
INVENTORY_APMC_ITEM_MAP_JSON=[{"itemId":"onion","commodity":"Onion","supplierId":"supplier_apmc"},{"itemId":"potato","commodity":"Potato","supplierId":"supplier_apmc"}]

# Optional private bucket for immutable raw response evidence.
INVENTORY_DOCUMENTS_BUCKET=your-private-inventory-documents-bucket
